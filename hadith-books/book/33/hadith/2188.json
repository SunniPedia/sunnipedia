    {
        "id": 1596894,
        "title": "امام کا نماز عید کو جانے کا وقت اور انتظار کرنا خطبے کا۔",
        "title_en": "",
        "title_ar": "",
        "title_without_harkat": "",
        "sub_title": null,
        "sub_title_ar": null,
        "sub_title_without_harkat": null,
        "status": "active",
        "sequence": null,
        "book_id": 33,
        "chapter_id": 2188,
